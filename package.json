{
  "name": "server-fetch",
  "version": "1.0.10",
  "description": "SSRF-safe fetch() for server-side use — validates IPs, enforces scheme/port, eliminates DNS rebinding via undici connect.lookup",
  "keywords": [
    "dns-rebinding",
    "fetch",
    "security",
    "server-side",
    "ssrf",
    "undici"
  ],
  "homepage": "https://github.com/GalvinGao/server-fetch#readme",
  "bugs": "https://github.com/GalvinGao/server-fetch/issues",
  "license": "MIT",
  "author": "GalvinGao",
  "repository": {
    "type": "git",
    "url": "https://github.com/GalvinGao/server-fetch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@j178/prek": "^0.5.5",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "undici": "^8.11.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "undici": "^8.11.2"
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}

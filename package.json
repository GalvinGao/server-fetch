{
  "name": "server-fetch",
  "version": "1.0.10",
  "description": "SSRF-safe fetch() for server-side use — validates IPs, enforces scheme/port, eliminates DNS rebinding via undici connect.lookup",
  "keywords": [
    "dns-rebinding",
    "fetch",
    "security",
    "server-side",
    "ssrf",
    "undici"
  ],
  "homepage": "https://github.com/GalvinGao/server-fetch#readme",
  "bugs": "https://github.com/GalvinGao/server-fetch/issues",
  "license": "MIT",
  "author": "GalvinGao",
  "repository": {
    "type": "git",
    "url": "https://github.com/GalvinGao/server-fetch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@j178/prek": "^0.4.3",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tsdown": "^0.22.0",
    "typescript": "6.0.3",
    "undici": "^8.3.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "undici": "^8.3.0"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
